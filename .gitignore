# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Virtual env ────────────────────────────────────────
.venv/
venv/

# ── Secrets ────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Local config / runtime ─────────────────────────────
config/
data/
.pytest_cache/

# Setup marker
setup_complete

# ── Storage runtime data ───────────────────────────────
src/localflight/storage/data/
src/localflight/storage/samples/*_real.json

# Optional: ignore ALL samples if you want clean repo
# src/localflight/storage/samples/*.json

# ── Logs ───────────────────────────────────────────────
*.log

# Local traffic / reporting runtime data
requests.db
bug_report_dedup.json
api_usage.json

# ── IDE / OS junk ──────────────────────────────────────
.vs/
.vscode/
.idea/
*.sqlite
*.db
.DS_Store
Thumbs.db

# ── Build artifacts ────────────────────────────────────
*.egg-info/
build/
dist/

# Mobile / React Native
mobile/node_modules/
mobile/.expo/
mobile/.expo-shared/
mobile/ios/
mobile/android/
mobile/npm-debug.log*
mobile/yarn-debug.log*
mobile/yarn-error.log*

# ── Relay server runtime (relay/) ─────────────────────
# relay/.env  — caught by the .env rule above
# relay/relay.db — caught by *.db above
# relay/__pycache__/ — caught by __pycache__/ above
relay/logs/

# ── Optional: private dev stuff ────────────────────────
dev/private/
assets/*.ico
assets/*.icns
assets/*.iconset
assets/*.png
!assets/icon_circle.png
!assets/icon_square.png
linear_dedup.json

# Claude Code local settings
.claude/
start_network.bat

# AI assistant context files
Claude.md
CLAUDE.md
.github/copilot-instructions.md

# Developer-only reference (not for public repo)
DEV_README.md
