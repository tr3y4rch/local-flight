<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="LocalFlightWidgetEyebrow">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:ellipsize">end</item>
    <item name="android:fontFamily">@font/space_mono_bold</item>
    <item name="android:maxLines">1</item>
    <item name="android:textColor">@color/localflight_widget_muted</item>
    <item name="android:textSize">8sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="LocalFlightWidgetRefresh">
    <item name="android:layout_width">36dp</item>
    <item name="android:layout_height">36dp</item>
    <item name="android:gravity">center</item>
    <item name="android:fontFamily">@font/dm_sans</item>
    <item name="android:text">↻</item>
    <item name="android:textColor">@color/localflight_widget_teal</item>
    <item name="android:textSize">18sp</item>
  </style>

  <style name="LocalFlightWidgetStatus">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:ellipsize">end</item>
    <item name="android:fontFamily">@font/space_mono_bold</item>
    <item name="android:maxLines">1</item>
    <item name="android:textColor">@color/localflight_widget_teal</item>
    <item name="android:textSize">9sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="LocalFlightWidgetInfo">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@color/localflight_widget_panel</item>
    <item name="android:fontFamily">@font/space_mono_bold</item>
    <item name="android:gravity">center</item>
    <item name="android:minWidth">30dp</item>
    <item name="android:paddingLeft">6dp</item>
    <item name="android:paddingRight">6dp</item>
    <item name="android:paddingTop">3dp</item>
    <item name="android:paddingBottom">3dp</item>
    <item name="android:textColor">@color/localflight_widget_text</item>
    <item name="android:textSize">10sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="LocalFlightWidgetRow">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@color/localflight_widget_panel</item>
    <item name="android:ellipsize">end</item>
    <item name="android:fontFamily">@font/dm_sans</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:layout_marginBottom">4dp</item>
    <item name="android:maxLines">2</item>
    <item name="android:minHeight">38dp</item>
    <item name="android:paddingLeft">9dp</item>
    <item name="android:paddingRight">9dp</item>
    <item name="android:paddingTop">5dp</item>
    <item name="android:paddingBottom">5dp</item>
    <item name="android:textColor">@color/localflight_widget_text</item>
    <item name="android:textSize">11sp</item>
  </style>
</resources>
