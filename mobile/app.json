{
  "expo": {
    "name": "Local Flight",
    "slug": "localflight-companion",
    "version": "0.2.7",
    "scheme": "localflight",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/localflight-icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080c12",
          "image": "./assets/localflight-logo.png",
          "imageWidth": 172,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080c12",
            "image": "./assets/localflight-logo.png"
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Local Flight scans pairing QR codes shown by your Local Flight desktop or Pi app."
        }
      ],
      "./plugins/with-localflight-privacy-manifest"
    ],
    "ios": {
      "bundleIdentifier": "com.localflight.companion",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Local Flight scans pairing QR codes shown by your Local Flight desktop or Pi app.",
        "NSLocalNetworkUsageDescription": "Local Flight connects to your Local Flight server on your local network.",
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.localflight.companion",
      "permissions": [
        "CAMERA"
      ]
    },
    "extra": {
      "localFlightServerHint": "http://192.168.1.10:8000",
      "localFlightVersion": "0.2.7"
    }
  }
}
