{
  "expo": {
    "name": "Local Flight",
    "slug": "localflight-mobile",
    "version": "0.5.2",
    "scheme": "localflight",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/localflight-ios-light.png",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1E8",
          "image": "./assets/localflight-splash-light.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#08141D",
            "image": "./assets/localflight-splash-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Local Flight scans pairing QR codes shown by your Local Flight host.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-localflight-android-network",
      "./plugins/with-localflight-privacy-manifest",
      "./plugins/with-localflight-ios-widget",
      "./plugins/with-localflight-android-widget",
      "expo-iap",
      "expo-background-task"
    ],
    "ios": {
      "bundleIdentifier": "cc.beacontools.localflight",
      "buildNumber": "9",
      "icon": {
        "light": "./assets/localflight-ios-light.png",
        "dark": "./assets/localflight-ios-dark.png",
        "tinted": "./assets/localflight-ios-tinted.png"
      },
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.cc.beacontools.localflight"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Local Flight scans pairing QR codes shown by your Local Flight host.",
        "NSLocalNetworkUsageDescription": "Local Flight connects to a Local Flight host on the same Wi-Fi.",
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cc.beacontools.localflight",
      "versionCode": 12,
      "icon": "./assets/localflight-android-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/localflight-android-foreground.png",
        "backgroundImage": "./assets/localflight-android-background.png",
        "backgroundColor": "#132638",
        "monochromeImage": "./assets/localflight-android-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "localFlightServerHint": "http://192.168.1.10:8000",
      "localFlightVersion": "0.5.2",
      "eas": {
        "projectId": "085634ce-4117-4fd6-b2d6-cbb7f90b4fdd",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LocalFlightWidget",
                  "bundleIdentifier": "cc.beacontools.localflight.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.cc.beacontools.localflight"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "tr3y4rch"
  }
}
