{
  "expo": {
    "name": "Local Flight",
    "slug": "localflight-mobile",
    "version": "0.2.8",
    "scheme": "localflight",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/localflight-icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f9fc",
          "image": "./assets/localflight-logo-light.png",
          "imageWidth": 172,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080c12",
            "image": "./assets/localflight-logo-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Local Flight scans pairing QR codes shown by your Local Flight desktop or Pi app.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-localflight-ios-widget",
      "./plugins/with-localflight-android-network",
      "./plugins/with-localflight-privacy-manifest"
    ],
    "ios": {
      "bundleIdentifier": "cc.beacontools.localflight",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/localflight-icon-light.png",
        "dark": "./assets/localflight-icon-dark.png"
      },
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Local Flight scans pairing QR codes shown by your Local Flight desktop or Pi app.",
        "NSLocalNetworkUsageDescription": "Local Flight connects to your Local Flight server on your local network.",
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cc.beacontools.localflight",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "localFlightServerHint": "http://192.168.1.10:8000",
      "localFlightVersion": "0.2.8",
      "eas": {
        "projectId": "085634ce-4117-4fd6-b2d6-cbb7f90b4fdd",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LocalFlightWidget",
                  "bundleIdentifier": "cc.beacontools.localflight.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.cc.beacontools.localflight"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "tr3y4rch"
  }
}
