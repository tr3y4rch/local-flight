{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_LOCALFLIGHT_DEPLOYMENT": "staging",
        "EXPO_PUBLIC_LOCALFLIGHT_RELAY_ORIGIN": "https://relay-staging.beacontools.cc"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_LOCALFLIGHT_DEPLOYMENT": "staging",
        "EXPO_PUBLIC_LOCALFLIGHT_RELAY_ORIGIN": "https://relay-staging.beacontools.cc"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "beta": {
      "distribution": "store",
      "environment": "preview",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_LOCALFLIGHT_DEPLOYMENT": "staging",
        "EXPO_PUBLIC_LOCALFLIGHT_RELAY_ORIGIN": "https://relay-staging.beacontools.cc"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_LOCALFLIGHT_DEPLOYMENT": "production",
        "EXPO_PUBLIC_LOCALFLIGHT_RELAY_ORIGIN": "https://relay.beacontools.cc"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "ascAppId": "6773962613"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6773962613"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
