---
import SiteLayout from "../layouts/SiteLayout.astro";
import RadarScope from "../components/RadarScope.astro";
import DestinationBoard from "../components/DestinationBoard.astro";
import SystemMap from "../components/SystemMap.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
---

<SiteLayout
  title="Beacon Tools"
  description="Download the free, open-source Local Flight app for airport-style boards, radar, history, phones, Raspberry Pi, and LED displays. No account or subscription required."
  active="home"
>
  <header class="terminal-hero">
    <div class="terminal-frame terminal-grid hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Beacon Tools / Open-source aviation displays</div>
        <h1 class="hero-title">Open-source flight boards. <span class="accent-word">Built for your screens.</span></h1>
        <p class="hero-lede">Local Flight creates airport-style arrivals and departures boards, nearby-aircraft radar, movement history, phone views, and LED displays. Run it on a computer or Raspberry Pi you control.</p>
        <div class="hero-actions">
          <a class="action-button action-button--primary" href="/local-flight/">Get Local Flight <span aria-hidden="true">→</span></a>
          <a class="action-link" href="#destinations">Explore every option</a>
        </div>
        <p class="hero-footnote">Free to download · No subscription · No account required · Optional online service</p>
      </div>
      <div class="hero-visual">
        <RadarScope caption="Beacon Terminal · illustrative product map · no live traffic" />
      </div>
    </div>
  </header>

  <section class="section" id="destinations">
    <div class="terminal-frame">
      <SectionHeading index="01 / START HERE" title="Start with what you want to do." description="Build your first flight board, add a phone, understand the connections, get help, or review your privacy choices." />
      <DestinationBoard />
    </div>
  </section>

  <section class="section section--raised section--ruled">
    <div class="terminal-frame">
      <SectionHeading index="02 / SYSTEM MAP" title="One Local Flight setup can power a whole collection of screens." description="The computer running Local Flight can serve browsers, phones, kiosks, and LED panels around your home or local network (LAN). Online features are separate and optional." />
      <SystemMap />
    </div>
  </section>

  <section class="section">
    <div class="terminal-frame">
      <SectionHeading index="03 / YOUR SETUP" title="The software runs for you, not around an account." description="The ownership model is simple: keep the core setup on your devices and choose whether any online feature is useful to you." />
      <div class="principle-run" data-reveal>
        <article class="principle">
          <span class="principle-index">01</span>
          <h3>Runs locally</h3>
          <p>The computer running Local Flight serves your board, browser screens, Companion phone, history, settings, and LED output.</p>
        </article>
        <article class="principle">
          <span class="principle-index">02</span>
          <h3>No account required</h3>
          <p>Download and use Local Flight without creating a Beacon Tools profile or signing into a subscription service.</p>
        </article>
        <article class="principle">
          <span class="principle-index">03</span>
          <h3>Online features are optional</h3>
          <p>Use Beacon Tools’ shared online service (Community Relay), add your own aviation-data API keys, or choose VATSIM virtual traffic.</p>
        </article>
        <article class="principle">
          <span class="principle-index">04</span>
          <h3>Open source</h3>
          <p>Read the source, follow each release, and inspect the software running on your own screens and computers.</p>
        </article>
      </div>
    </div>
  </section>

  <SafetyNotice />
</SiteLayout>
