---
import SiteLayout from "../layouts/SiteLayout.astro";
import RadarScope from "../components/RadarScope.astro";
import DestinationBoard from "../components/DestinationBoard.astro";
import SystemMap from "../components/SystemMap.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
---

<SiteLayout
  title="Beacon Tools"
  description="Meet the Local Flight ecosystem: free open-source desktop and server software, paid iOS, free Android Companion and VATSIM, and portable Beacon Relay Access."
  active="home"
>
  <header class="terminal-hero">
    <div class="terminal-frame terminal-grid hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Beacon Tools / The Local Flight ecosystem</div>
        <h1 class="hero-title">Your flight board. <span class="accent-word">Every screen, one ecosystem.</span></h1>
        <p class="hero-lede">Start with free, open-source Local Flight on a computer or Raspberry Pi. Add the mobile app for Companion or VATSIM, or portable Beacon Relay Access when you want hosted real-flight data.</p>
        <div class="hero-actions">
          <a class="action-button action-button--primary" href="/local-flight/">Download desktop free <span aria-hidden="true">→</span></a>
          <a class="action-link" href="/local-flight/relay-access/">Understand Relay Access</a>
        </div>
        <p class="hero-footnote">Desktop free and open source · Android Companion + VATSIM free · One Relay license per purchase · No subscription</p>
      </div>
      <div class="hero-visual">
        <RadarScope caption="Beacon Terminal · illustrative product map · no live traffic" />
      </div>
    </div>
  </header>

  <section class="section" id="destinations">
    <div class="terminal-frame">
      <SectionHeading index="01 / START HERE" title="Start with what you want to do." description="Build your first flight board, add a phone, understand the connections, get help, or review your privacy choices." />
      <DestinationBoard />
    </div>
  </section>

  <section class="section section--raised section--ruled">
    <div class="terminal-frame">
      <SectionHeading index="02 / SYSTEM MAP" title="One ecosystem, built around the screens you own." description="A Local Flight computer can serve browsers, phones, kiosks, and LED panels around your home network. A portable Relay license adds hosted access on one main device when you choose it." />
      <SystemMap />
    </div>
  </section>

  <section class="section">
    <div class="terminal-frame">
      <SectionHeading index="03 / HOW OWNERSHIP WORKS" title="Buy Relay Access where it fits. Keep the same rights." description="Stripe, a verified Apple app entitlement, and the Android in-app product all create the same kind of portable Beacon Relay license." />
      <div class="principle-run" data-reveal>
        <article class="principle">
          <span class="principle-index">01</span>
          <h3>Desktop stays free</h3>
          <p>Run the open-source desktop, Linux server, or Raspberry Pi build with Beacon Relay, Bring Your Own Keys, or VATSIM.</p>
        </article>
        <article class="principle">
          <span class="principle-index">02</span>
          <h3>Mobile fits each store</h3>
          <p>The paid iOS app includes one license. Android is free for Companion and VATSIM, with a one-time Relay purchase for real-flight Standalone.</p>
        </article>
        <article class="principle">
          <span class="principle-index">03</span>
          <h3>One active main device</h3>
          <p>Use a license on desktop Beacon Relay or mobile Standalone. Move it with confirmation when your setup changes.</p>
        </article>
        <article class="principle">
          <span class="principle-index">04</span>
          <h3>No Beacon account</h3>
          <p>Email is only for license delivery, protection, and recovery. There is no profile, password, or recurring plan.</p>
        </article>
      </div>
    </div>
  </section>

  <SafetyNotice />
</SiteLayout>
