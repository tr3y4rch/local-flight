---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SupportForms from "../../components/SupportForms.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import Icon from "../../components/Icon.astro";
---

<SiteLayout
  title="Support"
  description="Ask a Local Flight question, request mobile testing access, or report something that is not working on desktop, server, Raspberry Pi, mobile, radar, or LED matrix."
  active="support"
>
  <header class="terminal-hero terminal-hero--compact terminal-hero--text">
    <div class="terminal-frame terminal-grid hero-grid">
      <div class="hero-copy hero-copy--wide">
        <div class="eyebrow">Beacon Tools / Support</div>
        <h1 class="hero-title">Tell us what you’re trying to do.</h1>
        <p class="hero-lede">Ask a question when you want guidance or mobile testing access. Report something that is not working when device details and optional cleaned text logs could help investigate it.</p>
        <div class="hero-actions">
          <a class="action-button action-button--primary" href="#message">Ask a question <span aria-hidden="true">↓</span></a>
          <a class="action-link" href="#bug-report">Report something that isn’t working</a>
        </div>
        <p class="hero-footnote">No support account required · reply email optional · never include aviation-data keys, Relay keys, activation tokens, or other private credentials</p>
      </div>
    </div>
  </header>

  <section class="section section--compact">
    <div class="terminal-frame">
      <SectionHeading index="01 / START HERE" title="The answer may already be one step away." description="Use these direct routes for the most common tasks. If they do not fit, choose the closest form below—you do not need the technical name." />
      <div class="support-start-list" data-reveal>
        <a href="/local-flight/#downloads"><span class="icon-badge icon-badge--sm"><Icon name="download" /></span><strong>Download Local Flight</strong><p>Choose Windows, macOS, Linux, server, or Raspberry Pi.</p><i aria-hidden="true">↗</i></a>
        <a href="/network/"><span class="icon-badge icon-badge--sm"><Icon name="network" /></span><strong>Connection help</strong><p>Compare LAN, Companion, Standalone, VATSIM, own keys, and Beacon Relay.</p><i aria-hidden="true">↗</i></a>
        <a href="/local-flight/relay-access/manage/"><span class="icon-badge icon-badge--sm"><Icon name="key" /></span><strong>Recover Relay Access</strong><p>Protect a license, move it, release a device, or replace a lost key.</p><i aria-hidden="true">↗</i></a>
        <a href="/privacy/choices/"><span class="icon-badge icon-badge--sm"><Icon name="shield" /></span><strong>Privacy controls</strong><p>Change diagnostics, revoke a phone, reset, erase, or make a data request.</p><i aria-hidden="true">↗</i></a>
      </div>
    </div>
  </section>

  <SupportForms />
  <SafetyNotice />
</SiteLayout>
