---
import { Picture } from "astro:assets";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import MobileModeSwitcher from "../../../components/MobileModeSwitcher.astro";
import SafetyNotice from "../../../components/SafetyNotice.astro";
import { currentRelease } from "../../../data/site";
import iosFids from "../../../assets/screens/mobile/ios/current/fids-dark.png";
import iosRadar from "../../../assets/screens/mobile/ios/current/radar-dark.png";
import iosHistory from "../../../assets/screens/mobile/ios/current/history-dark.png";
import androidFids from "../../../assets/screens/mobile/android/current/fids-light.png";
import androidRadar from "../../../assets/screens/mobile/android/current/radar-light.png";
import androidHistory from "../../../assets/screens/mobile/android/current/history-light.png";
---

<SiteLayout
  title="Local Flight Mobile"
  description="Use Local Flight on iPhone or Android by connecting to an existing setup with Companion or running a phone-only board with Standalone. The apps are currently in testing."
  active="mobile"
>
  <header class="terminal-hero">
    <div class="terminal-frame terminal-grid hero-grid">
      <div class="hero-copy hero-copy--narrow">
        <div class="eyebrow">Local Flight Mobile / iOS + Android</div>
        <h1 class="hero-title">Take your flight board <span class="accent-word">with you.</span></h1>
        <p class="hero-lede">Connect to the Local Flight setup you already run with Companion, or use only your phone with Standalone. Both modes bring the board, nearby-aircraft radar, and recent movement history to iPhone and Android.</p>
        <div class="hero-actions">
          <a class="action-button action-button--primary" href="#modes">Compare the two modes <span aria-hidden="true">↓</span></a>
          <a class="action-link" href="#availability">Ask about mobile testing</a>
        </div>
        <p class="hero-footnote">Version {currentRelease} · TestFlight and Google Play testing · no ads · no cross-app tracking</p>
      </div>
      <div class="hero-visual hero-visual--wide phone-composition" aria-label="Local Flight Mobile interface previews" data-reveal>
        <div class="phone-frame phone-frame--primary">
          <Picture src={iosFids} formats={["avif", "webp"]} widths={[300, 480, 640]} sizes="(max-width: 680px) 52vw, 280px" alt="Local Flight Mobile flight board on iOS in dark appearance" loading="eager" />
        </div>
        <div class="phone-frame phone-frame--secondary">
          <Picture src={androidRadar} formats={["avif", "webp"]} widths={[300, 480, 640]} sizes="(max-width: 680px) 52vw, 280px" alt="Local Flight Mobile radar on Android in light appearance" loading="eager" />
        </div>
      </div>
    </div>
  </header>

  <section class="section" id="modes">
    <div class="terminal-frame">
      <SectionHeading index="01 / MODES" title="Use your existing setup—or just your phone." description="Companion connects to a Local Flight computer you already run. Standalone runs a simpler flight board from the phone itself. Compare the connection, history, and update timing below." />
      <MobileModeSwitcher />
    </div>
  </section>

  <section class="section section--raised section--ruled">
    <div class="terminal-frame">
      <SectionHeading index="02 / ON YOUR PHONE" title="A mobile interface designed for the screen in your hand." description="Move between the board, nearby-aircraft radar, movement history, setup, and widgets with navigation made for a phone." />
      <div class="feature-run" data-reveal>
        <article class="feature"><span class="feature-index">BOARD</span><h3>Arrivals and departures</h3><p>See airport-local times, weather, supplied status and gates, pinned flights, and when the board was last updated.</p></article>
        <article class="feature"><span class="feature-index">RADAR</span><h3>Nearby aircraft</h3><p>Follow the same 15-second sweep used by desktop and browser views, with phone-friendly range and detail controls.</p></article>
        <article class="feature"><span class="feature-index">HISTORY</span><h3>Recent movements</h3><p>Companion shows history from your Local Flight computer. Standalone keeps its recent movement history on the phone.</p></article>
        <article class="feature"><span class="feature-index">WIDGET</span><h3>A quick saved view</h3><p>Widgets show the latest copy saved by the app. They never contact your computer, Community Relay, or an aviation-data provider by themselves.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="terminal-frame">
      <SectionHeading index="03 / CURRENT BUILDS" title="Real screens from the current testing build." description={`These ${currentRelease} testing-build captures show iOS in dark appearance and Android in light appearance. They are real Local Flight screens, not generic device mockups.`} />
      <div class="preview-strip" data-reveal>
        <figure class="preview-phone"><Picture src={iosRadar} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight Radar on iOS in dark appearance" /><figcaption>iOS / RADAR · DARK APPEARANCE</figcaption></figure>
        <figure class="preview-phone"><Picture src={androidFids} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight flight board on Android in light appearance" /><figcaption>ANDROID / BOARD · LIGHT APPEARANCE</figcaption></figure>
        <figure class="preview-phone"><Picture src={iosHistory} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight History on iOS in dark appearance" /><figcaption>iOS / HISTORY · DARK APPEARANCE</figcaption></figure>
        <figure class="preview-phone"><Picture src={androidHistory} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight History on Android in light appearance" /><figcaption>ANDROID / HISTORY · LIGHT APPEARANCE</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--raised section--ruled">
    <div class="terminal-frame">
      <SectionHeading index="04 / WIDGETS" title="Flight information where your phone already looks." description="The native extensions turn the latest copy saved by Local Flight into a quick Home Screen view. A pinned flight can also appear as a Live Activity on supported iPhones." />
      <div class="extension-showcase" data-reveal>
        <figure class="extension-preview">
          <img src="/assets/previews/mobile/localflight-ios-widgets-marketing.svg" width="1600" height="1200" loading="lazy" alt="Local Flight iOS small and medium widgets beside a pinned-flight Lock Screen Live Activity" />
          <figcaption><strong>iOS / WIDGETKIT + LIVE ACTIVITY</strong><span>Current native testing extension · illustrative device context</span></figcaption>
        </figure>
        <figure class="extension-preview">
          <img src="/assets/previews/mobile/localflight-android-widgets-marketing.svg" width="1600" height="1200" loading="lazy" alt="Local Flight Android widget in compact pinned-flight and expanded airport-board sizes" />
          <figcaption><strong>ANDROID / RESIZABLE HOME SCREEN WIDGET</strong><span>Current native testing widget · illustrative device context</span></figcaption>
        </figure>
      </div>
      <p class="hero-footnote extension-note">Widgets show saved app information and do not fetch from your Local Flight computer, Community Relay, or an aviation-data provider by themselves. Device, operating-system, launcher, theme, and data differences can change the final appearance.</p>
    </div>
  </section>

  <section class="section section--quiet section--ruled">
    <div class="terminal-frame">
      <SectionHeading index="05 / UPDATE TIMING" title="What updates—and when—in phone-only mode." description="Standalone uses separate timing for new shared data and for updating the saved view already on the phone. These are target intervals, not guarantees; provider delays can keep an older board visible with its freshness time." />
      <div class="cadence-line cadence-line--mobile" data-reveal>
        <article class="cadence-item"><strong>About 1 h</strong><h3>Real-world schedules</h3><p>Standalone requests new shared airline-schedule data no more often than about once an hour.</p></article>
        <article class="cadence-item"><strong>Between checks</strong><h3>Saved board view</h3><p>The app keeps the latest board available and re-evaluates saved rows locally. This does not request a new airline schedule.</p></article>
        <article class="cadence-item"><strong>About 3 min</strong><h3>Real-world Radar</h3><p>Nearby aircraft can refresh about every three minutes while Radar is open, with 1, 3, 5, and 10 NM ranges.</p></article>
        <article class="cadence-item"><strong>About 1 min</strong><h3>VATSIM mode</h3><p>When Standalone uses public virtual-network data, both its board and Radar target about one-minute checks.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="availability">
    <div class="terminal-frame terminal-grid split-story">
      <div class="split-story-copy" data-reveal>
        <span class="section-index">06 / AVAILABILITY</span>
        <h2>The mobile apps are currently in testing.</h2>
        <p>Version {currentRelease} is currently distributed through TestFlight and Google Play internal testing. Public store badges remain unavailable until review is complete.</p>
        <ul class="data-list">
          <li><b>iOS</b><span>TestFlight testing with the permanent Local Flight application identity.</span></li>
          <li><b>Android</b><span>Google Play internal testing on the matching {currentRelease} contract.</span></li>
          <li><b>Questions</b><span>Ask about testing access, pairing, or which mode fits your setup.</span></li>
        </ul>
        <div class="inline-actions" style="margin-top: 30px">
          <a class="action-button action-button--primary" href="/support/#message">Ask about joining mobile testing <span aria-hidden="true">→</span></a>
        </div>
        <div class="store-release" aria-label="Mobile app store availability">
          <div class="store-badges">
            <!-- Future App Store URL requires the App Store app ID assigned after review. -->
            <span class="store-badge is-disabled" role="link" aria-disabled="true" aria-label="Download on the App Store">
              <img src="/assets/store-badges/download-on-app-store.svg" alt="Download on the App Store" />
            </span>
            <!-- Future Google Play URL: https://play.google.com/store/apps/details?id=cc.beacontools.localflight -->
            <span class="store-badge is-disabled" role="link" aria-disabled="true" aria-label="Get it on Google Play">
              <img src="/assets/store-badges/get-it-on-google-play.png" alt="Get it on Google Play" />
            </span>
          </div>
          <p class="store-note">Public store listings will open after store review.</p>
        </div>
      </div>
      <div class="split-story-media">
        <div class="media-stage" data-reveal>
          <Picture src={androidRadar} formats={["avif", "webp"]} widths={[420, 640, 860]} sizes="(max-width: 680px) 90vw, 46vw" alt="Local Flight Android Radar in light appearance" />
          <div class="media-caption"><strong>ANDROID / RADAR</strong><span>Current testing build · light appearance</span></div>
        </div>
      </div>
    </div>
  </section>

  <SafetyNotice subject="Local Flight Mobile board, radar, weather, map, and shared-service data" />

  <div class="terminal-frame store-legal">
    <p>Apple, the Apple logo, iPhone, and iPad are trademarks of Apple Inc. App Store is a service mark of Apple Inc.</p>
    <p>Google Play and the Google Play logo are trademarks of Google LLC. Android is a trademark of Google LLC.</p>
  </div>
</SiteLayout>
