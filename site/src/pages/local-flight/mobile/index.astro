---
import { Picture } from "astro:assets";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import MobileModeSwitcher from "../../../components/MobileModeSwitcher.astro";
import SafetyNotice from "../../../components/SafetyNotice.astro";
import { availability, currentRelease, relayOrigin } from "../../../data/site";
import iosFids from "../../../assets/screens/mobile/ios/current/fids-dark.png";
import iosHistory from "../../../assets/screens/mobile/ios/current/history-dark.png";
import androidFids from "../../../assets/screens/mobile/android/current/fids-light.png";
import androidRadar from "../../../assets/screens/mobile/android/current/radar-light.png";
import androidHistory from "../../../assets/screens/mobile/android/current/history-light.png";
---

<SiteLayout
  title="Local Flight Mobile"
  description="See Local Flight boards, radar, history, widgets, and Live Activity on iOS and Android. Connect to a Local Flight computer or use supported phone-only modes."
  active="mobile"
>
  <header class="terminal-hero terminal-hero--product">
    <div class="terminal-frame terminal-grid hero-grid">
      <div class="hero-copy hero-copy--narrow">
        <div class="eyebrow">Local Flight Mobile / iOS + Android</div>
        <h1 class="hero-title">Take your flight board with you.</h1>
        <p class="hero-lede">Connect to a Local Flight computer you already run with Companion, follow VATSIM directly on the phone, or use real-flight Standalone with optional Beacon Relay Access.</p>
        <div class="hero-actions">
          <a class="action-button action-button--primary" href="#modes">Compare Companion and Standalone <span aria-hidden="true">↓</span></a>
          <a class="action-link" href="#screens">See the app</a>
        </div>
        <p class="hero-footnote">Companion keeps the computer in charge · Standalone runs on the phone · No ads · No cross-app tracking</p>
      </div>
      <div class="hero-visual hero-visual--wide phone-composition" aria-label="Local Flight Mobile interface previews" data-reveal>
        <div class="phone-frame phone-frame--primary">
          <Picture src={iosFids} formats={["avif", "webp"]} widths={[300, 480, 640]} sizes="(max-width: 680px) 52vw, 280px" alt="Local Flight Mobile flight board on iOS in dark appearance" loading="eager" />
        </div>
        <div class="phone-frame phone-frame--secondary">
          <Picture src={androidRadar} formats={["avif", "webp"]} widths={[300, 480, 640]} sizes="(max-width: 680px) 52vw, 280px" alt="Local Flight Mobile radar on Android in light appearance" loading="eager" />
        </div>
      </div>
    </div>
  </header>

  <section class="section" id="modes">
    <div class="terminal-frame">
      <SectionHeading index="01 / CHOOSE A MODE" title="Use your existing setup—or just your phone." description="Companion connects to the computer running Local Flight. Standalone works directly on the phone, with VATSIM available without Relay Access and real-flight data available through Beacon Relay." />
      <MobileModeSwitcher />
    </div>
  </section>

  <section class="section section--raised section--ruled" id="screens">
    <div class="terminal-frame">
      <SectionHeading index="02 / REAL APP SCREENS" title="The same useful views, designed for a phone." description={`These ${currentRelease} testing-build captures show the real iOS app in dark appearance and Android app in light appearance.`} />
      <div class="preview-strip" data-reveal>
        <figure class="preview-phone"><Picture src={iosFids} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight flight board on iOS in dark appearance" /><figcaption>iOS / BOARD · DARK APPEARANCE</figcaption></figure>
        <figure class="preview-phone"><Picture src={androidRadar} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight nearby-aircraft radar on Android in light appearance" /><figcaption>ANDROID / RADAR · LIGHT APPEARANCE</figcaption></figure>
        <figure class="preview-phone"><Picture src={iosHistory} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight movement history on iOS in dark appearance" /><figcaption>iOS / HISTORY · DARK APPEARANCE</figcaption></figure>
        <figure class="preview-phone"><Picture src={androidHistory} formats={["avif", "webp"]} widths={[260, 420]} sizes="(max-width: 680px) 44vw, 22vw" alt="Local Flight movement history on Android in light appearance" /><figcaption>ANDROID / HISTORY · LIGHT APPEARANCE</figcaption></figure>
      </div>
      <div class="summary-lines summary-lines--compact mobile-outcomes" data-reveal>
        <div class="summary-line"><span>BRD</span><strong>Flight board</strong><p>Airport-local times, weather, supplied status and gates, pinned flights, and a visible freshness time.</p></div>
        <div class="summary-line"><span>RDR</span><strong>Nearby aircraft</strong><p>A phone-sized radar view using the same deliberate 15-second sweep as the desktop and browser displays.</p></div>
        <div class="summary-line"><span>HST</span><strong>Recent movements</strong><p>Companion reads history from the computer; Standalone keeps its own recent history on the phone.</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="widgets">
    <div class="terminal-frame">
      <SectionHeading index="03 / WIDGETS + LIVE ACTIVITY" title="Flight information where you already look." description="Native extensions show the latest copy saved by Local Flight. A pinned flight can also appear as a Live Activity on supported iPhones." />
      <div class="extension-showcase" data-reveal>
        <figure class="extension-preview">
          <img src="/assets/previews/mobile/localflight-ios-widgets-marketing.svg" width="1600" height="1200" loading="lazy" alt="Local Flight iOS widgets and a pinned-flight Lock Screen Live Activity" />
          <figcaption><strong>iOS / WIDGETS + LIVE ACTIVITY</strong><span>Native testing extension · illustrative device context</span></figcaption>
        </figure>
        <figure class="extension-preview">
          <img src="/assets/previews/mobile/localflight-android-widgets-marketing.svg" width="1600" height="1200" loading="lazy" alt="Local Flight Android compact pinned-flight and expanded airport-board widgets" />
          <figcaption><strong>ANDROID / HOME SCREEN WIDGETS</strong><span>Native testing widget · illustrative device context</span></figcaption>
        </figure>
      </div>
      <p class="hero-footnote extension-note">Widgets show saved app information. They do not contact your Local Flight computer, Beacon Relay, or an aviation-data provider by themselves. Device, operating-system, launcher, theme, and available data can change the final appearance.</p>
    </div>
  </section>

  <section class="section section--quiet section--ruled" id="store-model">
    <div class="terminal-frame">
      <SectionHeading index="04 / IOS + ANDROID" title="The app stores package Relay Access differently." description="The core choice is the same on both platforms: use Companion or VATSIM without a separate Relay license, or use one Relay license for real-flight Standalone." />
      <div class="platform-comparison" data-reveal>
        <div class="platform-row platform-row--head" aria-hidden="true"><span>Platform</span><span>App download</span><span>Companion + VATSIM</span><span>Real-flight Standalone</span></div>
        <article class="platform-row"><strong>iOS</strong><p>Paid app</p><p>Included in the app</p><p>One Beacon Relay license is included after App Store ownership is verified.</p></article>
        <article class="platform-row"><strong>Android</strong><p>Free app</p><p>Free to use</p><p>Uses an optional one-time Relay purchase or an existing Relay license moved to the phone.</p></article>
      </div>
      <p class="hero-footnote">A web or Android Relay purchase does not include the paid iOS download. Each completed Relay purchase or verified Apple entitlement creates a separate one-main-device license.</p>
    </div>
  </section>

  <section class="section" id="update-timing">
    <div class="terminal-frame">
      <SectionHeading index="05 / UPDATE TIMING" title="What updates—and when—in phone-only mode." description="Standalone checks shared data at conservative intervals and keeps the latest saved view available between checks. These are target intervals, not guarantees." />
      <div class="cadence-line cadence-line--mobile" data-reveal>
        <article class="cadence-item"><strong>About 1 h</strong><h3>Real-world schedules</h3><p>Standalone requests new shared airline-schedule data no more often than about once an hour.</p></article>
        <article class="cadence-item"><strong>Between checks</strong><h3>Saved board view</h3><p>The app keeps the latest board available and re-evaluates saved rows locally without requesting a new schedule.</p></article>
        <article class="cadence-item"><strong>About 3 min</strong><h3>Real-world radar</h3><p>Nearby aircraft can refresh about every three minutes while Radar is open, with 1, 3, 5, and 10 NM ranges.</p></article>
        <article class="cadence-item"><strong>About 1 min</strong><h3>VATSIM mode</h3><p>VATSIM board and Radar views target about one-minute checks while the phone is in use.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--raised section--ruled" id="availability" data-mobile-catalog data-relay-origin={relayOrigin} data-current-release={currentRelease} data-release-state={availability.relayAccess}>
    <div class="terminal-frame terminal-grid split-story">
      <div class="split-story-copy" data-reveal>
        <span class="section-index">06 / AVAILABILITY</span>
        <h2 id="mobileAvailabilityTitle">The mobile apps are currently in testing.</h2>
        <p id="mobileAvailabilityLead">Public store or testing links appear here only after Beacon Tools has verified that they are open to the intended audience.</p>
        <ul class="data-list">
          <li><b>iOS</b><span id="iosAvailabilityText">The paid iOS app and included Relay Access are still in testing.</span></li>
          <li><b>Android</b><span id="androidAvailabilityText">The free Android app and optional Relay purchase are still in testing.</span></li>
          <li><b>Relay</b><span>Relay Access purchasing is in prelaunch. No payment can be started yet.</span></li>
        </ul>
        <div class="inline-actions editorial-actions">
          <a class="action-button action-button--primary" href="/support/#message">Ask about mobile testing</a>
        </div>
        <div class="store-release" aria-label="Mobile app store availability">
          <div class="store-badges">
            <a class="store-badge is-disabled" data-mobile-store="apple_app" aria-disabled="true" aria-label="Download on the App Store"><img src="/assets/store-badges/download-on-app-store.svg" alt="Download on the App Store" /></a>
            <a class="store-badge is-disabled" data-mobile-store="google_play" aria-disabled="true" aria-label="Get it on Google Play"><img src="/assets/store-badges/get-it-on-google-play.png" alt="Get it on Google Play" /></a>
          </div>
          <p class="store-note" id="mobileAvailabilityStatus" role="status" aria-live="polite">No public store link is currently published.</p>
        </div>
      </div>
      <div class="split-story-media">
        <div class="media-stage" data-reveal>
          <Picture src={androidFids} formats={["avif", "webp"]} widths={[420, 640, 860]} sizes="(max-width: 680px) 90vw, 46vw" alt="Local Flight Android flight board in light appearance" />
          <div class="media-caption"><strong>ANDROID / FLIGHT BOARD</strong><span>Current testing build · light appearance</span></div>
        </div>
      </div>
    </div>
  </section>

  <SafetyNotice subject="Local Flight Mobile board, radar, weather, map, and shared-service data" />

  <div class="terminal-frame store-legal">
    <p>Apple, the Apple logo, iPhone, and iPad are trademarks of Apple Inc. App Store is a service mark of Apple Inc.</p>
    <p>Google Play and the Google Play logo are trademarks of Google LLC. Android is a trademark of Google LLC.</p>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-mobile-catalog]");
      const relay = root?.dataset.relayOrigin || "";
      const release = root?.dataset.currentRelease || "the current build";
      const title = document.getElementById("mobileAvailabilityTitle");
      const lead = document.getElementById("mobileAvailabilityLead");
      const status = document.getElementById("mobileAvailabilityStatus");
      const iosText = document.getElementById("iosAvailabilityText");
      const androidText = document.getElementById("androidAvailabilityText");

      const setStore = (sourceName, source, label, output) => {
        const link = document.querySelector(`[data-mobile-store="${sourceName}"]`);
        const state = String(source?.state || (source?.available ? "available" : "unavailable")).toLowerCase();
        const available = state === "available" && source?.available === true;
        const testing = state === "testing" && source?.testing_available === true;
        const candidate = available ? source?.store_url : testing ? source?.testing_url : "";
        const hasVerifiedLink = typeof candidate === "string" && candidate.startsWith("https://");
        if (hasVerifiedLink) {
          link.href = candidate;
          link.classList.remove("is-disabled");
          link.removeAttribute("aria-disabled");
        }
        output.textContent = available
          ? source?.included_with_paid_app
            ? `The paid ${label} release is available and includes one Relay license.`
            : `The free ${label} release is available; Relay Access remains an optional one-time purchase.`
          : testing
            ? `${label} testing is open for Local Flight ${release}.`
            : `${label} testing is not open through a public link yet.`;
        return available ? "live" : testing ? "testing" : "prelaunch";
      };

      const loadAvailability = async () => {
        try {
          const response = await fetch(`${relay}/v1/access/catalog`, { headers: { Accept: "application/json" } });
          const data = await response.json();
          const product = data?.product;
          if (!response.ok || !data?.ok || product?.product_code !== "beacon_relay_lifetime_v1" || product?.independent_receivers !== 1) return;
          const iosState = setStore("apple_app", product?.purchase_sources?.apple_app, "iOS", iosText);
          const googleSource = product?.purchase_sources?.google_play || product?.purchase_sources?.google_app;
          const androidState = setStore("google_play", googleSource, "Android", androidText);
          const states = [iosState, androidState];
          title.textContent = states.every((value) => value === "live")
            ? "The mobile apps are available."
            : states.some((value) => value === "live")
              ? "One mobile release is available."
              : "The mobile apps are currently in testing.";
          lead.textContent = states.some((value) => value !== "prelaunch")
            ? "Use only the verified store or testing links shown here; availability can differ by platform."
            : "Public store or testing links appear here only after Beacon Tools has verified that they are open to the intended audience.";
          status.textContent = states.some((value) => value === "live" || value === "testing")
            ? "Verified links are shown for the platforms currently open."
            : "No public store link is currently published.";
        } catch {
          /* Keep the intentional testing/prelaunch copy. A network error is not a product state. */
        }
      };
      loadAvailability();
    })();
  </script>
</SiteLayout>
