---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import SafetyNotice from "../../../components/SafetyNotice.astro";
import { availability, paidRelayExplanation, relayOrigin } from "../../../data/site";
---

<SiteLayout
  title="Beacon Relay Access"
  description="Beacon Relay is optional paid hosted access for real-flight data in Local Flight. The free open-source application, Bring Your Own Keys, and VATSIM remain separate."
  active="relay"
>
  <header class="terminal-hero terminal-hero--compact">
    <div class="terminal-frame terminal-grid hero-grid">
      <div class="hero-copy hero-copy--narrow">
        <div class="eyebrow">Local Flight / Optional hosted service</div>
        <h1 class="hero-title">Beacon Relay is the optional hosted path for real-flight data.</h1>
        <p class="hero-lede">It gives Local Flight a provider-authorized shared data path without asking you to arrange your own aviation-data accounts. It is separate from the free, open-source application.</p>
        <div class="hero-actions">
          <a class="action-button action-button--primary" href="#how-it-works">See how access works <span aria-hidden="true">↓</span></a>
          <a class="action-link" href="/local-flight/relay-access/manage/">Recover or manage existing access</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="relay-route-figure" aria-label="Beacon Relay connects one active main device to hosted real-flight data" data-reveal>
          <span>YOUR MAIN DEVICE</span><i aria-hidden="true"></i><strong>BEACON RELAY</strong><i aria-hidden="true"></i><span>HOSTED FLIGHT DATA</span>
          <small>One desktop installation or one mobile real-flight Standalone installation</small>
        </div>
      </div>
    </div>
  </header>

  <div class="terminal-frame prelaunch-notice" role="status" data-release-state={availability.relayAccess}>
    {availability.relayAccess === "live"
      ? <>
          <span>AVAILABLE</span>
          <p><strong>Relay Access is CHF 8 per year.</strong> It renews automatically until you cancel, and Stripe shows the final price and any tax before you pay.</p>
        </>
      : <>
          <span>PRELAUNCH</span>
          <p><strong>Relay Access purchases are being prepared.</strong> No payment can be started yet.</p>
        </>}
  </div>

  <section class="section" id="why-paid">
    <div class="terminal-frame terminal-grid editorial-pair">
      <div class="editorial-heading" data-reveal>
        <span class="section-index">01 / WHY IT IS PAID</span>
        <h2>The software is free. Hosted service has ongoing costs.</h2>
      </div>
      <div class="editorial-copy" data-reveal>
        <p>{paidRelayExplanation}</p>
        <a class="action-link" href="/local-flight/#downloads">Download the free application</a>
      </div>
    </div>
  </section>

  <section class="section section--raised section--ruled" id="how-it-works">
    <div class="terminal-frame">
      <SectionHeading index="02 / ONE MAIN DEVICE" title="Access follows the setup that needs hosted data." description="One annual entitlement can be active on one desktop Beacon Relay installation or one mobile real-flight Standalone installation at a time." />
      <div class="entitlement-map" data-reveal>
        <div class="entitlement-main"><span>ACTIVE MAIN DEVICE</span><strong>Desktop Beacon Relay <i>or</i> mobile real-flight Standalone</strong><p>Confirm a move when you change which main device uses the license.</p></div>
        <div class="entitlement-branch"><span>SHARES THE DESKTOP HOST</span><strong>LAN browsers · LED matrices · Companion phones</strong><p>These screens do not need their own Relay license.</p></div>
        <div class="entitlement-branch"><span>AWAY FROM HOME</span><strong>Remote Companion</strong><p>Uses the licensed desktop host and end-to-end encrypted messages. No additional license is needed.</p></div>
      </div>
      <p class="hero-footnote">New Relay Access renews annually at CHF 8/year. Eligible early users and existing permanent license holders keep their earlier access. Hosted service and aviation-data provider availability are not guaranteed; see the complete terms.</p>
    </div>
  </section>

  <section class="section" id="get-access" data-access-catalog data-relay-origin={relayOrigin} data-public-state={availability.relayAccess}>
    <div class="terminal-frame">
      <SectionHeading index="03 / PURCHASE ROUTES" title="Web, iOS, and Android use the same annual plan." description="Purchasing is not open yet. When it launches, each provider shows the final localized price and tax before confirmation." />
      <p class="catalog-status" id="accessCatalogStatus" role="status" aria-live="polite">Prelaunch · no purchase route is open.</p>
      <div class="acquisition-table" data-reveal>
        <div class="acquisition-row acquisition-row--head" aria-hidden="true"><span>Route</span><span>What is purchased</span><span>How Relay Access is provided</span><span>Current state</span></div>
        <article class="acquisition-row" data-purchase-source="stripe">
          <strong>Web</strong><p>A CHF 8/year Stripe subscription.</p><p>A portable key activates desktop or Pi and can later move to an eligible mobile main device.</p><span class="source-status" data-source-status>Prelaunch</span>
        </article>
        <article class="acquisition-row" data-purchase-source="apple_subscription">
          <strong>iOS</strong><p>The app is free; real-flight Standalone uses the annual App Store subscription.</p><p>Restore checks the subscription or eligible founder ownership before offering a purchase.</p><span class="source-status" data-source-status>Testing</span>
        </article>
        <article class="acquisition-row" data-purchase-source="google_play">
          <strong>Android</strong><p>The app is free; real-flight Standalone uses the annual Google Play subscription.</p><p>Companion, VATSIM, and eligible founder access remain available without a new purchase.</p><span class="source-status" data-source-status>Testing</span>
        </article>
      </div>
      <div class="purchase-prelaunch-action">
        <button class="action-button action-button--primary" type="button" id="relayCheckout" disabled>{availability.relayAccess === "live" ? "Checking availability…" : "Purchases are not open yet"}</button>
        <p class="form-status" id="relayCheckoutStatus" role="status" aria-live="polite">{availability.relayAccess === "live" ? "Confirming that Beacon Relay can complete a purchase right now." : "No payment can be started in the prelaunch state."}</p>
      </div>
      <p class="terms-note">The launch price is CHF 8/year. Stripe, the App Store, or Google Play shows the final localized currency and applicable tax before purchase. The <a href="/local-flight/relay-access/terms/">Relay Access terms</a> and <a href="/privacy/">privacy policy</a> remain available now.</p>
    </div>
  </section>

  <section class="section section--quiet section--ruled">
    <div class="terminal-frame terminal-grid split-story">
      <div class="split-story-copy" data-reveal>
        <span class="section-index">04 / USE AND MOVE</span>
        <h2>Keep hosted access separate from the free app.</h2>
        <p>iOS and Android downloads are free. A Stripe, App Store, or Google Play subscription creates its own Relay Access entitlement; unrelated purchases are not silently merged. Existing permanent licenses and eligible founder access remain permanent.</p>
        <ol class="action-checklist action-checklist--compact">
          <li><span class="step">01</span><strong>Use on a computer</strong><p>Enter the delivered <code>LFRA-…</code> key during Beacon Relay setup.</p></li>
          <li><span class="step">02</span><strong>Move to a phone</strong><p>Use the private management page to create a short-lived handoff. Mobile verifies the receiving app.</p></li>
          <li><span class="step">03</span><strong>Change main devices</strong><p>The old device stays active until the new credential has been safely stored and the move is committed.</p></li>
        </ol>
      </div>
      <aside class="split-story-media relay-access-note" data-reveal>
        <span class="section-index">OTHER DATA PATHS</span>
        <ul class="data-list relay-route-list">
          <li><b>Own keys</b><span>Bring Your Own Keys uses an appropriately licensed provider account and no Relay Access.</span></li>
          <li><b>VATSIM</b><span>Public virtual-network data remains available without Relay Access.</span></li>
          <li><b>Local</b><span>LAN screens and Companion devices use the desktop host rather than separate hosted access.</span></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="terminal-frame">
      <SectionHeading index="05 / PRACTICAL DETAILS" title="Access without a conventional Beacon account." description="Email is used only for web delivery, protection, recovery, or a device move. There is no profile, password, or advertising identity." />
      <div class="summary-lines summary-lines--compact" data-reveal>
        <div class="summary-line"><span>RCV</span><strong>Recover access</strong><p>Request a short-lived private link using the purchase or protection email. You can email the current key again without changing the active device.</p></div>
        <div class="summary-line"><span>MAIL</span><strong>Protect a mobile license</strong><p>Add and verify an email before retrieving a portable key or moving access. Payment receipts come from the payment provider; Beacon Tools sends delivery and recovery emails separately.</p></div>
        <div class="summary-line"><span>TIP</span><strong>Optional support</strong><p>Support purchases are one-time tips. They unlock nothing and do not create Relay Access or another license.</p></div>
        <div class="summary-line"><span>BILL</span><strong>Manage renewal</strong><p>Stripe subscribers use the secure billing portal. App Store and Google Play subscribers use their store subscription controls.</p></div>
        <div class="summary-line"><span>MOV</span><strong>Move the main device</strong><p>Create a one-use desktop activation code or verified mobile handoff.</p></div>
        <div class="summary-line"><span>KEY</span><strong>Replace a lost key</strong><p>Rotating a lost master key also revokes its old key and active device credential.</p></div>
      </div>
      <div class="inline-actions editorial-actions">
        <a class="action-button" href="/local-flight/relay-access/manage/">Recover or manage existing access</a>
        <a class="action-link" href="/local-flight/relay-access/terms/">Read the complete terms</a>
      </div>
    </div>
  </section>

  <SafetyNotice subject="Local Flight and Beacon Relay flight boards, radar, weather, map, and cached data" />

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-access-catalog]");
      const relay = root?.dataset.relayOrigin || "";
      const publicState = root?.dataset.publicState || "prelaunch";
      const button = document.getElementById("relayCheckout");
      const checkoutStatus = document.getElementById("relayCheckoutStatus");
      const catalogStatus = document.getElementById("accessCatalogStatus");

      const setSourceStatus = (source, message, tone = "") => {
        const output = document.querySelector(`[data-purchase-source="${source}"] [data-source-status]`);
        if (!output) return;
        output.textContent = message;
        output.dataset.tone = tone;
      };

      const loadCatalog = async () => {
        try {
          const response = await fetch(`${relay}/v1/access/catalog`, { headers: { Accept: "application/json" } });
          const data = await response.json();
          const product = data?.product;
          if (!response.ok || !data?.ok || data?.catalog_contract_version !== 2 || product?.product_code !== "beacon_relay_annual_v1" || product?.billing_period !== "P1Y" || product?.independent_receivers !== 1) return;
          const sources = product?.purchase_sources;
          // Never offer checkout unless the relay confirms it can actually serve
          // what the subscription pays for. Selling hosted schedules or Remote
          // Companion while the relay reports them unavailable would take money
          // for a capability the buyer could not use.
          const capabilities = data?.capabilities;
          const salesReady = publicState === "live"
            && capabilities?.sales === true
            && capabilities?.schedule === true
            && capabilities?.remote_companion === true
            && product?.sales_available === true
            && sources?.stripe?.available === true;
          button.disabled = !salesReady;
          button.textContent = salesReady ? "Continue to Stripe Checkout" : "Purchases are not open yet";
          setSourceStatus("stripe", salesReady ? "Available" : "Prelaunch", salesReady ? "ok" : "pending");
          setSourceStatus("apple_subscription", sources?.apple_subscription?.available ? "Available" : sources?.apple_subscription?.testing_available ? "Testing" : "Prelaunch", sources?.apple_subscription?.available ? "ok" : "pending");
          const google = sources?.google_play || sources?.google_app;
          setSourceStatus("google_play", google?.available ? "Available" : google?.testing_available ? "Testing" : "Prelaunch", google?.available ? "ok" : "pending");
          catalogStatus.textContent = salesReady ? "Web purchasing is available." : "Prelaunch · no purchase route is open.";
          catalogStatus.dataset.tone = salesReady ? "ok" : "pending";
        } catch {
          /* Keep the intentional prelaunch message. Network state must not become sales copy. */
        }
      };

      button?.addEventListener("click", async () => {
        if (publicState !== "live") return;
        button.disabled = true;
        checkoutStatus.textContent = "Opening secure checkout…";
        try {
          const response = await fetch(`${relay}/v1/access/stripe/checkout`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ website_context: "relay_access_page" }),
          });
          const data = await response.json();
          if (!response.ok || !data.checkout_url || !data.checkout_ref || !data.result_secret) throw new Error(data?.detail?.message || "Checkout is not available yet.");
          sessionStorage.setItem(`beacon.relay.checkout.${data.checkout_ref}`, data.result_secret);
          window.location.assign(data.checkout_url);
        } catch (error) {
          checkoutStatus.textContent = error instanceof Error ? error.message : "Checkout is not available yet.";
          checkoutStatus.dataset.tone = "bad";
          button.disabled = false;
        }
      });

      loadCatalog();
    })();
  </script>
</SiteLayout>
