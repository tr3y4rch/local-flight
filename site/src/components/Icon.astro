---
// Inline SVG only. The site ships no icon font and loads nothing from a CDN
// (the build contract asserts there is no external font/analytics origin), and
// `currentColor` keeps every icon correct in both themes for free.
const paths = {
  board: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 13h10M7 16.5h6"/>',
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  relay: '<circle cx="12" cy="12" r="2"/><path d="M7.8 7.8a6 6 0 0 0 0 8.4M16.2 16.2a6 6 0 0 0 0-8.4M4.9 4.9a10 10 0 0 0 0 14.2M19.1 19.1a10 10 0 0 0 0-14.2"/>',
  radar: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.3"/><path d="M12 12 18.4 5.6"/>',
  history: '<path d="M3.5 12a8.5 8.5 0 1 0 2.7-6.2"/><path d="M3 4.5V9h4.5"/><path d="M12 7.5V12l3 1.8"/>',
  matrix: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7.5 9.5h.01M12 9.5h.01M16.5 9.5h.01M7.5 14.5h.01M12 14.5h.01M16.5 14.5h.01"/>',
  monitor: '<rect x="2.5" y="4" width="19" height="12.5" rx="2"/><path d="M8.5 20.5h7M12 16.5v4"/>',
  shield: '<path d="M12 3 4.5 6.2v5.3c0 4.4 3.1 8.1 7.5 9.5 4.4-1.4 7.5-5.1 7.5-9.5V6.2Z"/><path d="m9 12 2 2 4-4"/>',
  key: '<circle cx="8" cy="14" r="4"/><path d="m11 11 8.5-8.5M16.5 5.5 19 8M14 8l2.5 2.5"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  download: '<path d="M12 3.5v11m0 0 4.5-4.5M12 14.5 7.5 10"/><path d="M4 16.5v2.5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2.5"/>',
  code: '<path d="m8.5 8-5 4 5 4M15.5 8l5 4-5 4"/>',
  network: '<circle cx="12" cy="4.8" r="2.3"/><circle cx="5" cy="19.2" r="2.3"/><circle cx="19" cy="19.2" r="2.3"/><path d="M12 7.1v4.4M11.2 12.2 6.2 17M12.8 12.2l5 4.8"/>',
  message: '<path d="M20.5 12.3c0 3.9-3.8 7.1-8.5 7.1-.9 0-1.8-.1-2.6-.3L4.5 20.5l1.3-3.5a6.8 6.8 0 0 1-2.3-4.7c0-3.9 3.8-7.1 8.5-7.1s8.5 3.2 8.5 7.1Z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.4 2.5 3.6 5.6 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.6-3.6-9S9.6 5.5 12 3Z"/>',
  plug: '<path d="M9 2.5v6M15 2.5v6"/><path d="M6.5 8.5h11v2.6a5.5 5.5 0 0 1-11 0Z"/><path d="M12 16.6v4.9"/>',
  eyeOff: '<path d="m4 4 16 16"/><path d="M9.9 5.3A9.5 9.5 0 0 1 12 5.1c5 0 9 4.3 9 6.9 0 .9-.5 2-1.4 3.1M6.4 7.2C4 8.7 3 10.8 3 12c0 2.6 4 6.9 9 6.9 1.4 0 2.8-.3 4-.9"/><path d="M10.4 10.5a2.2 2.2 0 0 0 3.1 3.1"/>',
  refresh: '<path d="M20.4 11a8.4 8.4 0 0 0-14.3-4.7L3 9.4"/><path d="M3 4.8v4.6h4.6"/><path d="M3.6 13a8.4 8.4 0 0 0 14.3 4.7L21 14.6"/><path d="M21 19.2v-4.6h-4.6"/>',
  card: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19M6.5 14.5h3.5"/>',
  sliders: '<path d="M4 7.5h9M19 7.5h1M4 16.5h1M11 16.5h9"/><circle cx="16" cy="7.5" r="2.4"/><circle cx="8" cy="16.5" r="2.4"/>',
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
