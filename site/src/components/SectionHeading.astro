---
interface Props {
  index: string;
  title: string;
  description?: string;
}

const { index, title, description } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div>
    <span class="section-index">{index}</span>
    <h2>{title}</h2>
  </div>
  {description && <p>{description}</p>}
</header>
