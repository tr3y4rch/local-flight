# Local Flight example config.
# The setup wizard writes these for you on first launch.

# Client setup defaults
LOCALFLIGHT_ACTIVATION_TOKEN=
LOCALFLIGHT_RELAY_URL=https://relay.beacontools.cc
LOCALFLIGHT_GUI_MODE=native

AVIATIONSTACK_API_KEY=
LOCALFLIGHT_AVIATIONSTACK_ENABLED=1
LOCALFLIGHT_AVIATIONSTACK_MONTHLY_LIMIT=90
LOCALFLIGHT_AVIATIONSTACK_DAILY_LIMIT=
AERODATABOX_API_KEY=
# apimarket is the direct API.Market gateway; use rapidapi only for RapidAPI subscriptions.
LOCALFLIGHT_AERODATABOX_MARKETPLACE=apimarket
LOCALFLIGHT_AERODATABOX_ENABLED=1
LOCALFLIGHT_AERODATABOX_MONTHLY_UNITS_LIMIT=24000
LOCALFLIGHT_AERODATABOX_DAILY_UNITS_LIMIT=
LOCALFLIGHT_REAL_SCHEDULE_PROVIDER=auto
# Counts relay schedule accesses per install, not raw shared upstream pulls.
LOCALFLIGHT_RELAY_MONTHLY_LIMIT=50

RAPIDAPI_KEY=
LOCALFLIGHT_RAPIDAPI_MONTHLY_LIMIT=10000

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Hosted relay operator knobs. Keep real values in Fly secrets/dashboard.
RELAY_SCHEDULE_PROVIDER=auto
RELAY_SCHEDULE_STALE_IF_ERROR_HOURS=24
RELAY_SCHEDULE_NETWORK_RPM_LIMIT=120
RELAY_SCHEDULE_INSTALL_RPM_LIMIT=30
RELAY_SCHEDULE_GLOBAL_RPM_LIMIT=600
# Set community schedule or new-cache-key limits to 0 as an operator kill switch.
RELAY_COMMUNITY_SCHEDULE_LIMIT=50
RELAY_COMMUNITY_SCHEDULE_MIN_FRESH_TTL_SECONDS=3600
RELAY_SCHEDULE_NEW_KEYS_NETWORK_DAILY_LIMIT=20
RELAY_SCHEDULE_NEW_KEYS_GLOBAL_DAILY_LIMIT=200
RELAY_AERODATABOX_UPSTREAM_MONTHLY_UNITS_LIMIT=24000
RELAY_AERODATABOX_UPSTREAM_DAILY_UNITS_LIMIT=
RELAY_AERODATABOX_FIDS_TIER2_UNITS=2
RELAY_AERODATABOX_MARKETPLACE=apimarket
RELAY_AVIATIONSTACK_UPSTREAM_MONTHLY_LIMIT=10000
RELAY_AVIATIONSTACK_UPSTREAM_DAILY_LIMIT=
RELAY_PROVIDER_FAILURE_COOLDOWN_SECONDS=600

# Relay Access licensing. Production stays in legacy mode until every launch
# gate passes; switch directly to licensed at cutover. Keep all secrets and
# localized Stripe price IDs in the deployment secret store, not this file.
RELAY_ACCESS_MODE=legacy
# Production accepts only production commerce proof. Staging accepts only
# TestFlight sandbox, Stripe test-mode, and Google Play test proof.
RELAY_ACCESS_DEPLOYMENT_ENVIRONMENT=production
RELAY_ACCESS_PRODUCT_CODE=beacon_relay_lifetime_v1
RELAY_ACCESS_HASH_SECRET=
RELAY_ACCESS_HASH_SECRET_ID=v1
RELAY_ACCESS_KEY_SECRET=
RELAY_ACCESS_KEY_SECRET_ID=v1
RELAY_ACCESS_ENCRYPTION_SECRET=
RELAY_ACCESS_ENCRYPTION_SECRET_ID=v1
# Old versioned keys remain configured until every persisted reference has
# been explicitly rehashed/re-encrypted.
RELAY_ACCESS_HISTORICAL_HASH_SECRETS_JSON={}
RELAY_ACCESS_HISTORICAL_KEY_SECRETS_JSON={}
RELAY_ACCESS_HISTORICAL_ENCRYPTION_SECRETS_JSON={}
RELAY_ACCESS_SITE_URL=https://beacontools.cc
RELAY_ACCESS_DISPLAY_PRICE=
RELAY_ACCESS_SALES_ENABLED=0
RELAY_ACCESS_MOBILE_OWNERSHIP_ENABLED=0
RELAY_ACCESS_IOS_STATE=unavailable
RELAY_ACCESS_IOS_TEST_URL=
RELAY_ACCESS_IOS_STORE_URL=
RELAY_ACCESS_ANDROID_STATE=unavailable
RELAY_ACCESS_ANDROID_TEST_URL=
RELAY_ACCESS_ANDROID_STORE_URL=
RELAY_ACCESS_SCHEDULE_ENABLED=0
RELAY_ACCESS_RADAR_ENABLED=0
RELAY_ACCESS_REMOTE_COMPANION_ENABLED=0
# Optional provider overrides inherit the broad capability when blank. Set a
# provider to 0 to stop both new pulls and cached licensed delivery immediately.
RELAY_ACCESS_AERODATABOX_ENABLED=
RELAY_ACCESS_AVIATIONSTACK_ENABLED=
RELAY_ACCESS_ADSBEXCHANGE_ENABLED=
# Set this only on the isolated staging relay so TestFlight, Stripe test-mode,
# and Play internal-test licenses can exercise staged data. Production keeps 0.
RELAY_ACCESS_ALLOW_TEST_LICENSES=0
RELAY_LICENSED_SCHEDULE_LIMIT=600
RELAY_LICENSED_RADAR_LIMIT=600
# Abuse controls for public purchase, recovery, and activation surfaces.
RELAY_ACCESS_CHECKOUT_HOURLY_LIMIT=10
RELAY_ACCESS_RESULT_10M_LIMIT=60
RELAY_ACCESS_ACTIVATION_10M_LIMIT=20
RELAY_ACCESS_ACTIVATION_COMMIT_10M_LIMIT=20
RELAY_ACCESS_ATTESTATION_10M_LIMIT=30
RELAY_ACCESS_VERIFICATION_10M_LIMIT=15
RELAY_ACCESS_MAGIC_LINK_HOURLY_LIMIT=5
RELAY_ACCESS_MAGIC_EXCHANGE_10M_LIMIT=20
RELAY_ACCESS_GRANT_10M_LIMIT=20
RELAY_ACCESS_ACTION_10M_LIMIT=10
RELAY_ACCESS_DEACTIVATION_10M_LIMIT=10
RELAY_ACCESS_STATUS_MINUTE_LIMIT=120
RELAY_ACCESS_WS_TICKET_MINUTE_LIMIT=30
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RELAY_ACCESS_PRICE_ID=
APPLE_APP_ID=
APPLE_IAP_BUNDLE_ID=cc.beacontools.localflight
APPLE_ROOT_CERTIFICATES_B64_JSON=
APPLE_APP_TRANSACTION_ONLINE_CHECKS=1
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_PRIVATE_KEY_B64=
GOOGLE_PLAY_PACKAGE_NAME=cc.beacontools.localflight
GOOGLE_RELAY_ACCESS_PRODUCT_ID=cc.beacontools.localflight.relay_access
# Use production only on the production relay; staging uses test.
GOOGLE_PLAY_PURCHASE_ENVIRONMENT=production
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=

# WAL-consistent encrypted backups. Licensed production refuses to start
# unless this is enabled with a fourth, purpose-separated secret.
RELAY_ACCESS_BACKUP_ENABLED=0
RELAY_ACCESS_BACKUP_DIRECTORY=
RELAY_ACCESS_BACKUP_SECRET=
RELAY_ACCESS_BACKUP_KEY_ID=v1
RELAY_ACCESS_HISTORICAL_BACKUP_SECRETS_JSON={}

# Beacon Tools sends license and recovery emails. The financial receipt stays
# with Stripe. These reuse RELAY_CONTACT_SMTP_* when left blank.
RELAY_LICENSE_SMTP_HOST=
RELAY_LICENSE_SMTP_PORT=587
RELAY_LICENSE_SMTP_USERNAME=
RELAY_LICENSE_SMTP_PASSWORD=
RELAY_LICENSE_SMTP_STARTTLS=1
RELAY_LICENSE_SMTP_SSL=0
RELAY_LICENSE_FROM=

# Beacon Tools public support forms. Keep real values in Fly secrets/dashboard.
# Preferred names are RELAY_CONTACT_*; deployed legacy aliases SMTP_HOST,
# SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_SECURITY, MAIL_FROM, MAIL_TO, and
# PRIVACY_TO are still accepted for operator convenience.
RELAY_CONTACT_SMTP_HOST=
RELAY_CONTACT_SMTP_PORT=587
RELAY_CONTACT_SMTP_USERNAME=
RELAY_CONTACT_SMTP_PASSWORD=
RELAY_CONTACT_SMTP_STARTTLS=1
RELAY_CONTACT_SMTP_SSL=0
RELAY_CONTACT_FROM=
RELAY_CONTACT_TO_GENERAL=
RELAY_CONTACT_TO_PRIVACY=
RELAY_SITE_CONTACT_NETWORK_DAILY_LIMIT=12
RELAY_SITE_BUG_NETWORK_DAILY_LIMIT=8
