#!/bin/sh
set -e

if [ "${1:-}" = "remove" ]; then
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop localflight-server.service >/dev/null || true
    elif command -v systemctl >/dev/null 2>&1; then
        systemctl stop localflight-server.service || true
    fi
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper disable localflight-server.service >/dev/null || true
    elif command -v systemctl >/dev/null 2>&1; then
        systemctl disable localflight-server.service || true
    fi
fi

exit 0
