# Local Flight Community Relay — environment variables
# Copy this file to relay/.env for local development. Never commit .env.
# On Fly.io use: fly secrets set KEY=value  (keys go in secrets, not fly.toml)

# ── Required ───────────────────────────────────────────────────────────────────
RELAY_ADMIN_PASSWORD=change-this-to-something-secure

# Provider API keys — set here as env-var fallback or via the relay admin panel
AVIATIONSTACK_API_KEY=your-aviationstack-key-here
RAPIDAPI_KEY=your-rapidapi-key-here

# ── Storage / server ──────────────────────────────────────────────────────────
DB_PATH=./relay.db    # use /data/relay.db on Fly.io (persistent volume)
PORT=8080

# ── Budget limits (optional — defaults shown) ─────────────────────────────────
RELAY_MONTHLY_LIMIT=50              # per-install AviationStack cap, rolling 30-day window
RELAY_MANAGED_SCHEDULE_LIMIT=10000  # global AviationStack cap (your subscription total)
RELAY_RADAR_MONTHLY_LIMIT=600       # global radar cap across all community installs
RELAY_MANAGED_RADAR_LIMIT=10000     # global managed radar cap (your RapidAPI subscription)
RELAY_RADAR_CACHE_SECONDS=300       # radar proxy cache TTL in seconds
